    "%@ Forced HDR modes exceed macOS resolution and refresh rate limits. May result in a corrupted image, green screen, or blank screen." : {
      "comment" : "53438 - Warning for forced HDR connection modes exceeding operating system limits. Preserve the icon placeholder at the beginning of the translation."
    },
    "%@ Hold ⌥ Option when opening this menu to measure refresh rate!" : {
