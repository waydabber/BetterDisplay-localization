    },
    "%@ Mixed modes are color modes that do not match the current framebuffer or Display Preset configuration. Choosing such a mode may result in unexpected behavior or a blank screen." : {
      "comment" : "53438 - Color mode menu help: mixed modes do not match the current framebuffer or Display Preset configuration. Preserve the icon placeholder at the beginning of the translation."
    },
    "%@ must restart to apply the imported settings.\n\nIf you imported settings from a different installation, macOS display identifiers (UUIDs) may not match this installation. As a result, various imported settings may not get immediately applied to the connected displays.\n\nUse the 'Transfer display settings' feature under all affected displays' additional settings to fix the identifier mismatch issue." : {
      "comment" : "50000 - Settings import restart alert. Transfer display settings associates imported settings with the current display identifiers."
    },
    "%@ needs administrator access to modify system display configuration." : {
