    "[Privacy Policy](https://betterdisplay.pro/privacy)" : {
      "comment" : "50000 - Link to the product privacy policy."
    },
    "**%@ License Issue Detected**\n\nThis installation has been remotely deactivated, or the hardware identifiers have changed since the last license activation. This may have occurred due to a hardware upgrade or migration to a new device.\n\nPlease reactivate this installation to continue using Pro features." : {
      "comment" : "50000 - License activation alert. %@ is the app name; reactivation refers to this installation, not restarting the app."
    },
    "**%@ Outdated License**\n\nThe provided license was originally issued for an earlier version of %@ and has already been extended once with a complimentary upgrade to a subsequent major version.\n\nThis license no longer covers the current app version (v%@). To use this version of %@, please purchase a new license.\n\nThank you for your understanding and continued support." : {
      "comment" : "50000 - License version eligibility alert. Placeholders are the app name, app name, current version, and app name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "**%1$@ Outdated License**\n\nThe provided license was originally issued for an earlier version of %2$@ and has already been extended once with a complimentary upgrade to a subsequent major version.\n\nThis license no longer covers the current app version (v%3$@). To use this version of %4$@, please purchase a new license.\n\nThank you for your understanding and continued support."
          }
        }
      }
    },
